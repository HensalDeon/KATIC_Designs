/**
 * `pnpm api:contract`: regenerates the resource reference of docs/API_CONTRACT.md (between the
 * `api-contract:generated` markers) plus one JSON example and one JSON Schema per resource under
 * docs/api-contract/, from the endpoint table, the Zod schemas and the static content. The doc can
 * therefore never describe something the site does not parse.
 *
 *   pnpm api:contract           # write
 *   pnpm api:contract --check   # exit 1 when the committed output is stale
 */
import { mkdir, readFile, rm, writeFile } from "node:fs/promises";
import { register } from "node:module";
import { dirname, relative } from "node:path";
import { fileURLToPath } from "node:url";

import type { ZodType } from "zod";

import { installAssetRequireHook } from "../mock-laravel/asset-hooks.mjs";

installAssetRequireHook();
register(new URL("../mock-laravel/asset-hooks.mjs", import.meta.url));

const { z } = await import("zod");
const prettier = await import("prettier");
const { ENDPOINT_NAMES, ENDPOINTS, endpointPath, exampleArgs } =
  await import("@/lib/data/laravel/endpoints");
const { staticResource } = await import("../mock-laravel/resources.mjs");
const { leadSchema } = await import("@/lib/leads/schema");
const { revalidateBodySchema } = await import("@/lib/revalidate/handler");

type Endpoint = (typeof ENDPOINTS)[keyof typeof ENDPOINTS];

const ROOT = fileURLToPath(new URL("../../", import.meta.url));
const DOC = `${ROOT}docs/API_CONTRACT.md`;
const OUT = `${ROOT}docs/api-contract`;
const MEDIA_ORIGIN = "https://cms.katicdesigns.com";
const START = "<!-- api-contract:generated:start -->";
const END = "<!-- api-contract:generated:end -->";
const check = process.argv.includes("--check");

const kebab = (name: string) => name.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`);
const files = new Map<string, string>();

async function pretty(text: string, filepath: string): Promise<string> {
  const options = (await prettier.resolveConfig(filepath)) ?? {};
  return prettier.format(text, { ...options, filepath });
}

async function addJson(path: string, value: unknown) {
  files.set(path, await pretty(JSON.stringify(value), path));
}

function jsonSchema(schema: ZodType, io: "input" | "output") {
  return z.toJSONSchema(schema, { io, unrepresentable: "any", target: "draft-2020-12" });
}

/** A short excerpt of an example for the doc: long lists cut to two items, long strings cut. */
function excerpt(value: unknown, depth = 0): unknown {
  if (typeof value === "string") return value.length > 90 ? `${value.slice(0, 87)}…` : value;
  if (Array.isArray(value)) {
    const head = value.slice(0, 2).map((item) => excerpt(item, depth + 1));
    return value.length > 2 ? [...head, `… ${value.length - 2} more`] : head;
  }
  if (typeof value === "object" && value !== null) {
    if (depth >= 3) return "{…}";
    return Object.fromEntries(Object.entries(value).map(([k, v]) => [k, excerpt(v, depth + 1)]));
  }
  return value;
}

const sections: string[] = [
  "## Resource reference (generated)",
  "",
  `Generated by \`pnpm api:contract\` from \`src/lib/data/laravel/endpoints.ts\`, the Zod schemas and the static content. Every resource is \`GET\`, needs the bearer token, answers \`200 { "data": … }\` (\`401\` without a valid token), and is cached by the site under the listed tags. Full examples are in [docs/api-contract/examples](./api-contract/examples) and JSON Schemas (draft 2020-12, of \`data\`) in [docs/api-contract/schemas](./api-contract/schemas). Media URLs in the examples use the placeholder origin \`${MEDIA_ORIGIN}\`.`,
  "",
  "| Method | Path | Repository method | Cache tags | 404 | Schema |",
  "| ------ | ---- | ----------------- | ---------- | --- | ------ |",
];
const details: string[] = [];

for (const name of ENDPOINT_NAMES) {
  const endpoint: Endpoint = ENDPOINTS[name];
  const args = exampleArgs(name);
  const file = kebab(name);
  const data = await staticResource(name, args, MEDIA_ORIGIN);
  await addJson(`${OUT}/examples/${file}.json`, { data });
  await addJson(`${OUT}/schemas/${file}.json`, jsonSchema(endpoint.schema, "output"));

  const query = "query" in endpoint ? `?${endpoint.query.map((q) => `${q}=`).join("&")}` : "";
  const notFound = "notFound" in endpoint ? "unknown slug" : "—";
  const schemaCell = `[schema](./api-contract/schemas/${file}.json)`;
  sections.push(
    `| GET | \`${endpoint.path}${query}\` | \`${name}\` | ${endpoint.tags.map((t) => `\`${t}\``).join(", ")} | ${notFound} | ${schemaCell} |`,
  );

  const examplePath = endpointPath(endpoint, args);
  details.push(
    `### \`GET ${endpoint.path}${query}\``,
    "",
    `${endpoint.summary} Repository: \`${name}()\`. Example: \`GET ${examplePath}\` ([full response](./api-contract/examples/${file}.json), [schema](./api-contract/schemas/${file}.json)).`,
    "",
    "```json",
    JSON.stringify({ data: excerpt(data) }, null, 2),
    "```",
    "",
  );
}

// Request bodies the site sends / accepts.
const leadPayloadSchema = leadSchema.omit({ company_website: true }).extend({
  submittedAt: z.iso.datetime(),
  subject: z.string(),
  userAgent: z.string().optional(),
});
const leadExample = {
  name: "Jane Doe",
  email: "jane@email.com",
  phone: "+91 98470 00000",
  service: "Interior Design",
  location: "Kerala",
  timeline: "3–6 months",
  details: "A three-bedroom apartment in Kochi.",
  source: {
    form: "popup",
    path: "/services/interior",
    title: "Interior Designers in Kochi, Kerala",
  },
  submittedAt: "2026-11-20T12:00:00.000Z",
  subject: "Project enquiry — Interior Design (Interior Designers in Kochi, Kerala)",
  userAgent: "Mozilla/5.0 …",
};
const parsedLead = leadPayloadSchema.safeParse(leadExample);
if (!parsedLead.success) throw new Error(`lead example is invalid: ${parsedLead.error.message}`);
await addJson(`${OUT}/examples/post-leads.json`, leadExample);
await addJson(`${OUT}/schemas/post-leads.json`, jsonSchema(leadPayloadSchema, "input"));
await addJson(`${OUT}/schemas/post-revalidate.json`, jsonSchema(revalidateBodySchema, "input"));

sections.push(
  "",
  "### `POST /leads` body",
  "",
  "[Schema](./api-contract/schemas/post-leads.json) · [example](./api-contract/examples/post-leads.json)",
  "",
  "```json",
  JSON.stringify(leadExample, null, 2),
  "```",
  "",
  "### `POST /api/revalidate` body (site)",
  "",
  "[Schema](./api-contract/schemas/post-revalidate.json)",
  "",
  ...details,
);

const doc = await readFile(DOC, "utf8");
const start = doc.indexOf(START);
const end = doc.indexOf(END);
if (start < 0 || end < start) throw new Error(`${DOC} lacks the ${START} / ${END} markers`);
const body = `${doc.slice(0, start + START.length)}\n\n${sections.join("\n")}\n\n${doc.slice(end)}`;
files.set(DOC, await pretty(body, DOC));

let stale = 0;
for (const [path, text] of files) {
  const current = await readFile(path, "utf8").catch(() => "");
  if (current === text) continue;
  stale += 1;
  if (check) console.error(`stale: ${relative(ROOT, path)}`);
  else {
    await mkdir(dirname(path), { recursive: true });
    await writeFile(path, text);
  }
}
if (!check) {
  // Drop outputs of endpoints that no longer exist.
  const { readdir } = await import("node:fs/promises");
  for (const folder of ["examples", "schemas"]) {
    for (const entry of await readdir(`${OUT}/${folder}`)) {
      const path = `${OUT}/${folder}/${entry}`;
      if (!files.has(path)) await rm(path);
    }
  }
}
console.log(
  check
    ? stale
      ? `${stale} file(s) stale: run pnpm api:contract`
      : "api contract is up to date"
    : `wrote ${stale} of ${files.size} file(s)`,
);
if (check && stale) process.exit(1);
