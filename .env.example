# Copy to .env.local and fill in. Never commit real values.

# Public site URL, used for canonical URLs, sitemap, Open Graph and JSON-LD.
# Unset in a build = https://www.katicdesigns.com (src/lib/seo/site-url.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lead intake endpoint (Laravel API in Phase 11). Empty = leads are logged in dev only.
LEADS_ENDPOINT=
