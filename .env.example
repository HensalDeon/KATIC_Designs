# Copy to .env.local and fill in. Never commit real values.
# Server variables are validated when next.config.ts loads (build, start, dev):
# src/lib/env/server-env.ts lists what is missing and stops.

# Public site URL, used for canonical URLs, sitemap, Open Graph and JSON-LD.
# Unset in a build = https://www.katicdesigns.com (src/lib/seo/site-url.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Content source (Phase 11) ---------------------------------------------------------------
# static  = typed content in src/content (default).
# laravel = the Laravel REST API (docs/API_CONTRACT.md). Requires LARAVEL_API_URL,
#           LARAVEL_API_TOKEN and REVALIDATE_SECRET. Local: `pnpm mock:laravel` serves the static
#           content as the API on http://127.0.0.1:3651/api/v1.
DATA_SOURCE=static

# Base URL of the API, including its version prefix, without a trailing slash.
LARAVEL_API_URL=
# Sanctum token with read-only abilities, sent as `Authorization: Bearer <token>`. Server-only.
LARAVEL_API_TOKEN=
# Optional: where media files are served from when not the API's origin (e.g. a CDN or bucket,
# with a path prefix: https://cdn.katicdesigns.com/media). next/image only optimises this host.
LARAVEL_MEDIA_URL=
# Optional: timeout per content request in ms (default 8000).
LARAVEL_API_TIMEOUT_MS=

# Shared secret of POST /api/revalidate (HMAC-SHA256 key, at least 16 characters).
# Generate: openssl rand -hex 32. Laravel signs every webhook with the same value.
REVALIDATE_SECRET=

# --- Leads ------------------------------------------------------------------------------------
# Lead intake endpoint, normally ${LARAVEL_API_URL}/leads. Empty = leads are logged in dev only,
# and production answers 503 so the visitor gets the email / WhatsApp fallback.
LEADS_ENDPOINT=
# Token for LEADS_ENDPOINT (`Authorization: Bearer`), a separate write-only Sanctum ability.
LEADS_API_TOKEN=
