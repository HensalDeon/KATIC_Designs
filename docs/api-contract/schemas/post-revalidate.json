{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tags": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,127}$" }
    },
    "immediate": { "type": "boolean" }
  },
  "required": ["tags"],
  "additionalProperties": false
}
