{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "email": { "type": "string", "minLength": 1 },
    "phone": { "type": "string", "maxLength": 40 },
    "service": {
      "type": "string",
      "enum": [
        "Architectural Design",
        "Interior Design",
        "Construction & Execution",
        "Turnkey Projects",
        "Renovation & Remodeling",
        "Exterior & Landscape Design",
        "Property Care & Maintenance",
        "Not sure yet"
      ]
    },
    "location": {
      "type": "string",
      "enum": ["Kerala", "Elsewhere in India", "Dubai / UAE", "Other"]
    },
    "projectType": {
      "type": "string",
      "enum": ["Home / Villa", "Apartment", "Commercial", "Hospitality", "Institutional"]
    },
    "timeline": {
      "type": "string",
      "enum": [
        "As soon as possible",
        "Within 3 months",
        "3–6 months",
        "6–12 months",
        "Just exploring"
      ]
    },
    "budget": {
      "type": "string",
      "enum": [
        "Under ₹50 lakh",
        "₹50 lakh – ₹1 crore",
        "₹1 – 3 crore",
        "Above ₹3 crore",
        "Prefer to discuss"
      ]
    },
    "details": { "type": "string", "maxLength": 4000 },
    "extra": {
      "type": "object",
      "propertyNames": { "type": "string", "maxLength": 60 },
      "additionalProperties": { "type": "string", "maxLength": 200 }
    },
    "source": {
      "type": "object",
      "properties": {
        "form": { "type": "string", "enum": ["popup", "contact"] },
        "path": { "type": "string", "maxLength": 300 },
        "title": { "type": "string", "maxLength": 200 }
      },
      "required": ["form", "path", "title"]
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "subject": { "type": "string" },
    "userAgent": { "type": "string" }
  },
  "required": ["name", "email", "service", "source", "submittedAt", "subject"]
}
